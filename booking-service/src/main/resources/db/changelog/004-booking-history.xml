<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="4-booking-history" author="booking-service">
        <createTable tableName="booking_history">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_booking_history_booking"
                             references="bookings(id)"/>
            </column>
            <column name="previous_status" type="VARCHAR(255)"/>
            <column name="new_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="initiator" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_booking_history_booking_time" tableName="booking_history">
            <column name="booking_id"/>
            <column name="changed_at" descending="true"/>
            <column name="id" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
